# Project
APP_NAME=pxss-bid-agent
APP_ENV=local
APP_DEBUG=true
# Structured log verbosity (DEBUG/INFO/WARNING/ERROR). INFO emits per-request
# and per-task access logs with request_id/task_id correlation.
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pxss_bid_agent
POSTGRES_USER=pxss
POSTGRES_PASSWORD=pxss_dev_password
DATABASE_URL=postgresql+psycopg://pxss:pxss_dev_password@localhost:5432/pxss_bid_agent

# Redis
REDIS_IMAGE=redis:7-alpine
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# MinIO
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=pxss_minio
MINIO_ROOT_PASSWORD=pxss_minio_password
MINIO_BUCKET=bid-agent

# LLM provider placeholders
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_SIMPLE_MODEL=deepseek-v4-flash
LLM_COMPLEX_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=30

# Aliyun OCR (读光 OCR / ocr-api20210707 RecognizeAdvanced 高精全文+表格)
# 控制台开通「文字识别 OCR」服务后填写 AccessKey；凭证不入库、不进日志。
ALIYUN_OCR_ENABLED=false
ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
ALIYUN_OCR_TIMEOUT_SECONDS=30

# Embedding provider: infinity | local
# 默认 infinity（docker compose 里的 infinity 服务，OpenAI 风格 /embeddings）。
# bge-base-zh-v1.5：中文专精，102M，输出 768 维（pgvector 列对齐 768）。
EMBEDDING_PROVIDER=infinity
EMBEDDING_BASE_URL=http://localhost:7997
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_FALLBACK_ENABLED=true

# Rerank provider: infinity | local
# bge-reranker-base：278M，多语，匹配上面的嵌入模型。
RERANK_ENABLED=true
RERANK_PROVIDER=infinity
RERANK_BASE_URL=http://localhost:7997
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TIMEOUT_SECONDS=30
RERANK_TOP_K=50
RERANK_FALLBACK_ENABLED=true

# Source PDF page images kept with extracted materials.
# These are compressed evidence previews, not OCR input images.
SOURCE_PAGE_IMAGE_FORMAT=jpeg
SOURCE_PAGE_IMAGE_MAX_WIDTH=1200
SOURCE_PAGE_IMAGE_JPEG_QUALITY=70
SOURCE_PAGE_IMAGE_RENDER_SCALE=2.0

# DB model config API key encryption
# Generate with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
MODEL_CONFIG_ENCRYPTION_KEY=
MODEL_CONFIG_ENCRYPTION_KEY_VERSION=v1
