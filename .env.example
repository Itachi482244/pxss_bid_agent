# Project
APP_NAME=pxss-bid-agent
APP_ENV=local
APP_DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pxss_bid_agent
POSTGRES_USER=pxss
POSTGRES_PASSWORD=pxss_dev_password
DATABASE_URL=postgresql+psycopg://pxss:pxss_dev_password@localhost:5432/pxss_bid_agent

# Redis
REDIS_IMAGE=redis:7-alpine
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# MinIO
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=pxss_minio
MINIO_ROOT_PASSWORD=pxss_minio_password
MINIO_BUCKET=bid-agent

# LLM provider placeholders
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_SIMPLE_MODEL=deepseek-v4-flash
LLM_COMPLEX_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=30

# DB model config API key encryption
# Generate with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
MODEL_CONFIG_ENCRYPTION_KEY=
MODEL_CONFIG_ENCRYPTION_KEY_VERSION=v1
